---
import { t } from '../i18n/ui';
interface Props { locale: 'en' | 'es'; }
const { locale } = Astro.props;
const orgs = [
  { name: 'Scrap-MF', url: 'https://github.com/Scrap-MF' },
  { name: 'ExtractorsMF', url: 'https://github.com/ExtractorsMF' },
  { name: 'AlejandraDB-MF', url: 'https://github.com/AlejandraDB-MF' },
  { name: 'MFApplications', url: 'https://github.com/MFApplications' },
];
---
<section id="about" class="section">
  <div class="container about">
    <div>
      <h2>{t(locale, 'about.title')}</h2>
      <p>{t(locale, 'about.body')}</p>
      <h3>{t(locale, 'about.orgs')}</h3>
      <ul class="org-list">
        {orgs.map((o) => <li><a href={o.url} rel="noopener" target="_blank">{o.name}</a></li>)}
      </ul>
    </div>
    <div class="support">
      <h3>{t(locale, 'support.title')}</h3>
      <p>{t(locale, 'support.body')}</p>
      <a href="https://ko-fi.com/mfapplications" rel="noopener" target="_blank">
        <img src="https://storage.ko-fi.com/cdn/kofi2.png?v=3" alt="Buy Me a Coffee at ko-fi.com" height="36" style="border:0;height:36px;" loading="lazy" />
      </a>
    </div>
  </div>
</section>

<style>
  .section { padding: var(--space-7) 0; border-top: 1px solid var(--border); }
  .about { display: grid; grid-template-columns: 1.5fr 1fr; gap: var(--space-6); align-items: start; }
  .org-list { list-style: none; padding: 0; margin: var(--space-2) 0 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .org-list a { font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; }
  .support {
    padding: var(--space-5); border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface);
  }
  .support p { color: var(--muted); }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 10px 18px; border-radius: var(--radius);
    font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 0.9375rem;
    border: 1px solid transparent;
  }
  .btn-kofi { background: var(--kofi); color: #fff; }
  .btn-kofi:hover { opacity: 0.85; text-decoration: none; }
  @media (max-width: 720px) { .about { grid-template-columns: 1fr; } }
</style>